{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://looprig.dev/schemas/examples.schema.json",
  "title": "Looprig documentation examples",
  "type": "object",
  "additionalProperties": false,
  "required": ["progressive", "examples"],
  "properties": {
    "progressive": { "type": "boolean" },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "stage",
          "owner",
          "versions",
          "offlineCommand",
          "assertion",
          "workflowPath",
          "jobId",
          "cleanup",
          "proofIds"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "stage": { "type": "integer", "minimum": 1, "maximum": 23 },
          "owner": { "type": "string", "minLength": 1 },
          "versions": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string", "minLength": 1 }
          },
          "offlineCommand": { "type": "string", "minLength": 1 },
          "assertion": { "type": "string", "minLength": 1 },
          "workflowPath": { "type": "string", "minLength": 1 },
          "jobId": { "type": "string", "minLength": 1 },
          "cleanup": { "type": "string", "minLength": 1 },
          "liveGate": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "type": "object" },
              { "type": "null" }
            ]
          },
          "proofIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
